#!/usr/bin/env bash
# Render HTML (and PNG when the local trmnlp build supports it) for both plugins.
# Usage: bin/preview
# Writes to previews/stats/ and previews/profile/.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${HOME}/.local/share/gem/ruby/3.2.0/bin:${PATH}"

if ! command -v trmnlp >/dev/null 2>&1; then
  echo "trmnlp not found. Install with: gem install trmnl_preview" >&2
  exit 1
fi

render_plugin() {
  local plugin="$1"
  local dest="$ROOT/previews/$plugin"
  mkdir -p "$dest"
  (
    cd "$ROOT/plugins/$plugin"
    trmnlp build
    cp -f tmp/full.html tmp/half_horizontal.html tmp/half_vertical.html tmp/quadrant.html "$dest/"
    shopt -s nullglob
    for png in tmp/*.png; do
      cp -f "$png" "$dest/"
    done
  )
  echo "Wrote HTML for $plugin to $dest"
}

render_plugin stats
render_plugin profile
echo "Done."
