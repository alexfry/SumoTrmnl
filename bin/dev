#!/usr/bin/env bash
# Start the trmnlp local development server for one plugin.
# Usage: bin/dev [stats|profile]
# Requires: gem install trmnl_preview  (or Docker image trmnl/trmnlp)
set -euo pipefail

PLUGIN="${1:-stats}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

case "$PLUGIN" in
  stats|profile) ;;
  *)
    echo "Usage: bin/dev [stats|profile]" >&2
    exit 1
    ;;
esac

PLUGIN_DIR="$ROOT/plugins/$PLUGIN"
cd "$PLUGIN_DIR"

if command -v trmnlp >/dev/null 2>&1; then
  exec trmnlp serve
fi

if command -v docker >/dev/null 2>&1; then
  exec docker run --publish 4567:4567 --volume "$PLUGIN_DIR:/plugin" trmnl/trmnlp serve
fi

echo "Install trmnlp (gem install trmnl_preview) or Docker image trmnl/trmnlp." >&2
exit 1
