<div class="layout layout--col gap--small">

  <div class="flex flex--between flex--center-y">
    <span class="label label--small" style="opacity: 0.55;">{{ basho_name }} {{ basho_year }}</span>
    <span class="label label--small" style="opacity: 0.55;">
      {% if status == "active" %}Day {{ day }} / {{ total_days }}
      {% elsif status == "complete" %}Complete
      {% else %}Upcoming{% endif %}
    </span>
  </div>

  <div class="divider"></div>

  <div class="flex flex--col gap--small">
    <span class="label label--small" style="opacity: 0.5; text-transform: uppercase; letter-spacing: 0.07em;">
      {% if status == "complete" %}Champion{% else %}Leader{% endif %}
    </span>
    <span class="value value--large">{{ leaders | join: " · " }}</span>
    <span class="label">
      {{ leader_wins }}W
      {% if status == "active" %}&nbsp;–&nbsp;{{ day | minus: leader_wins }}L{% endif %}
    </span>
  </div>

  {% if status == "complete" or status == "upcoming" %}
    <div class="divider"></div>
    <div class="flex flex--between flex--center-y">
      <span class="label label--small" style="opacity: 0.5; text-transform: uppercase; letter-spacing: 0.06em;">Next</span>
      <span class="label"><strong>{{ next_basho_name }}</strong> in {{ days_until_next }}d</span>
    </div>
  {% endif %}

</div>

<div class="title_bar">
  <span class="title">Sumo Stats</span>
  <span class="instance">{{ division }} Division</span>
</div>

<script>terminalize()</script>
