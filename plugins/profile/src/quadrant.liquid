<style>
  .layout { padding: 0 !important; margin: 0 !important; }
  .view { padding: 0 !important; }
</style>

<div style="display: flex; flex-direction: row; width: 400px; height: 240px; overflow: hidden;">

  <div style="width: 140px; flex-shrink: 0; overflow: hidden;">
    {% if image_url != "" and image_url != nil %}
      <img class="image image-dither image--cover"
           src="{{ image_url }}"
           style="display: block; width: 140px; height: 240px; object-fit: cover; object-position: top;">
    {% else %}
      <div style="width: 140px; height: 240px; display: flex; align-items: center; justify-content: center;">
        <span style="font-size: 40px; opacity: 0.15;">?</span>
      </div>
    {% endif %}
  </div>

  <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 10px 12px 10px 14px; gap: 0;">

    <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px; margin-bottom: 8px;">
      {% if kanji_img_url != "" and kanji_img_url != nil %}
        <img class="image image-dither"
             src="{{ kanji_img_url }}"
             style="display: block; height: 24px;">
      {% endif %}
      <span class="title" style="font-size: 20px; line-height: 1;">{{ shikona }}</span>
    </div>

    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 4px;">
      <div><span class="label label--small">Rank</span>&nbsp;<span class="label" style="font-weight: bold;">{{ rank }}</span></div>
      <div><span class="label label--small">Peak</span>&nbsp;<span class="label">{{ highest_rank }}</span></div>
    </div>

    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 8px;">
      {% if age != nil %}
        <div><span class="label label--small">Age</span>&nbsp;<span class="label">{{ age }}</span></div>
      {% endif %}
      {% if height != "" and height != nil %}
        <div><span class="label label--small">Height</span>&nbsp;<span class="label">{{ height }}</span></div>
      {% endif %}
    </div>

    <div style="margin-bottom: 6px;">
      <span class="title value--tnums" style="font-size: 16px;">{{ total_wins }}W &ndash; {{ total_losses }}L &ndash; {{ total_absents }}A</span>
      <div><span class="label label--small">{{ total_bashos }} basho · {{ yusho }} Yusho · {{ special_prizes }} Prizes</span></div>
    </div>

    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      {% if heya != "" and heya != nil %}
        <div><span class="label label--small">Stable</span>&nbsp;<span class="label">{{ heya }}</span></div>
      {% endif %}
      {% if shusshin != "" and shusshin != nil %}
        <div><span class="label label--small">From</span>&nbsp;<span class="label">{{ shusshin }}</span></div>
      {% endif %}
    </div>

  </div>

</div>

<script>terminalize()</script>
