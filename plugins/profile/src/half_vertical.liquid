<style>
  .layout { padding: 0 !important; margin: 0 !important; }
  .view { padding: 0 !important; }
  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    border-radius: 6px;
    padding: 5px 6px;
    flex: 1;
  }
</style>

<div style="display: flex; flex-direction: row; width: 400px; height: 480px; overflow: hidden;">

  <div style="width: 160px; flex-shrink: 0; overflow: hidden;">
    {% if image_url != "" and image_url != nil %}
      <img class="image image-dither image--cover"
           src="{{ image_url }}"
           style="display: block; width: 160px; height: 480px; object-fit: cover; object-position: top;">
    {% else %}
      <div style="width: 160px; height: 480px; display: flex; align-items: center; justify-content: center;">
        <span style="font-size: 48px; opacity: 0.15;">?</span>
      </div>
    {% endif %}
  </div>

  <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 14px 12px 14px 14px; gap: 0;">

    <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 6px; margin-bottom: 10px;">
      {% if kanji_img_url != "" and kanji_img_url != nil %}
        <img class="image image-dither"
             src="{{ kanji_img_url }}"
             style="display: block; height: 32px;">
      {% endif %}
      <span class="title" style="font-size: 22px; line-height: 1;">{{ shikona }}</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 8px;">
      <div><span class="label label--small">Rank</span>&nbsp;<span class="label" style="font-weight: bold;">{{ rank }}</span></div>
      <div><span class="label label--small">Peak</span>&nbsp;<span class="label">{{ highest_rank }}</span></div>
      {% if heya != "" and heya != nil %}
        <div><span class="label label--small">Stable</span>&nbsp;<span class="label">{{ heya }}</span></div>
      {% endif %}
      {% if shusshin != "" and shusshin != nil %}
        <div><span class="label label--small">From</span>&nbsp;<span class="label">{{ shusshin }}</span></div>
      {% endif %}
    </div>

    <div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      {% if age != nil %}
        <div><span class="label label--small">Age</span>&nbsp;<span class="label">{{ age }}</span></div>
      {% endif %}
      {% if height != "" and height != nil %}
        <div><span class="label label--small">Height</span>&nbsp;<span class="label">{{ height }}</span></div>
      {% endif %}
      {% if weight != "" and weight != nil %}
        <div><span class="label label--small">Weight</span>&nbsp;<span class="label">{{ weight }}</span></div>
      {% endif %}
    </div>

    <div class="stat-box" style="margin-bottom: 6px;">
      <span class="title value--tnums" style="font-size: 15px;">{{ total_wins }}W &ndash; {{ total_losses }}L &ndash; {{ total_absents }}A</span>
      <span class="label label--small">{{ total_bashos }} basho career</span>
    </div>

    <div style="display: flex; gap: 5px; margin-bottom: 10px;">
      <div class="stat-box">
        <span class="title value--tnums">{{ yusho }}</span>
        <span class="label label--small">Yusho</span>
      </div>
      <div class="stat-box">
        <span class="title value--tnums">{{ jun_yusho }}</span>
        <span class="label label--small">Jun-Yusho</span>
      </div>
      <div class="stat-box">
        <span class="title value--tnums">{{ special_prizes }}</span>
        <span class="label label--small">Prizes</span>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 4px;">
      {% if first_basho != "" and first_basho != nil %}
        <div><span class="label label--small">Debut</span>&nbsp;<span class="label label--small">{{ first_basho }}</span></div>
      {% endif %}
      <div><span class="label label--small">Status</span>&nbsp;<span class="label label--small">{{ status }}</span></div>
    </div>

  </div>

</div>

<script>terminalize()</script>
